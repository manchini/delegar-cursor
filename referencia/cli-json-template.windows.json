{
  "permissions": {
    "allow": [
      "Shell(Get-ChildItem*)",
      "Shell(Get-Content*)",
      "Shell(Select-String*)",
      "Shell(ls)",
      "Shell(cat)",
      "Shell(head)",
      "Shell(tail)",
      "Shell(wc)",
      "Shell(grep)",
      "Shell(rg)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:branch*)",
      "Shell(git:blame*)",
      "Shell(cargo:check*)",
      "Shell(cargo:build*)",
      "Shell(cargo:test*)",
      "Shell(cargo:fmt*)",
      "Shell(cargo:clippy*)",
      "Shell(cargo:tree*)",
      "Shell(npm:run*)",
      "Shell(npm:ci*)",
      "Shell(npm:install)",
      "Shell(pnpm:run*)",
      "Shell(pnpm:install)",
      "Shell(pnpm:build*)",
      "Shell(pnpm:test*)",
      "Shell(python:-m pytest*)",
      "Shell(pytest*)",
      "Shell(ruff*)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(rmdir)",
      "Shell(del)",
      "Shell(find)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:push*)",
      "Shell(git:reset*)",
      "Shell(git:clean*)",
      "Shell(git:checkout*)",
      "Shell(npm:run dev*)",
      "Shell(pnpm:run dev*)",
      "Shell(cargo:publish*)",
      "Shell(cargo:install*)",
      "Shell(npm:publish*)",
      "Shell(msbuild*)",
      "Write(.cursor/**)",
      "Write(scripts/deploy/**)",
      "Read(.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  }
}
